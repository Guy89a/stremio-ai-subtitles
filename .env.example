# Copy this to a file called .env and run:  node --env-file=.env src/boot.js

GEMINI_API_KEY=paste-your-key-here
PORT=7788

# The defaults below were chosen after real use. You should not need to change them.
# CONCURRENCY=1          # do not raise this - it is what burns the per-minute quota
# CHUNK_SIZE=80
# MIN_SPLIT=2
# CONTEXT_CUES=12

# Flash translates better; Flash-Lite has a larger free daily quota and takes
# over automatically when Flash runs out.
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK=gemini-flash-lite-latest

# Target language (ISO 639-2). Any other language also works without
# redeploying, by putting its code in the install address.
# TARGET_LANG=heb

# Limits that protect your quota and the server's memory
# RATE_LIMIT_PER_DAY=40    # new episodes per day, per caller
# RATE_LIMIT_TOTAL=200     # ceiling for the whole service
# MAX_JOBS=3               # translations running at once
# MAX_SUBTITLE_BYTES=2000000

# Settle every recurring proper name once, before translating
# NAME_GLOSSARY=1

# MAX_SOURCES=2
# UPSTREAM_ADDONS=https://opensubtitles-v3.strem.io
