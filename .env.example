# העתק לקובץ בשם .env והרץ:  node --env-file=.env src/boot.js

GEMINI_API_KEY=הדבק-כאן-את-המפתח
PORT=7788

# ברירות המחדל שנבחרו אחרי ניסיון בפועל. אין צורך לשנות.
# CONCURRENCY=1          # לא להעלות - זה מה ששורף את המכסה לדקה
# CHUNK_SIZE=80
# MIN_SPLIT=2
# CONTEXT_CUES=12

# המודל נבחר אוטומטית מתוך הרשימה החיה של גוגל.
# לקביעה ידנית (רשימה מופרדת בפסיקים, הראשון שעונה מנצח):
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK=

# תקרות שמגנות על המכסה ועל הזיכרון של השרת
# RATE_LIMIT_PER_DAY=40    # פרקים חדשים ליום לכל פונה
# RATE_LIMIT_TOTAL=200     # תקרה לכל השרת ביחד
# MAX_JOBS=3               # תרגומים במקביל
# MAX_SUBTITLE_BYTES=2000000

# MAX_SOURCES=2
# UPSTREAM_ADDONS=https://opensubtitles-v3.strem.io
